# Production deployment template — contains no usable secret.
#
# Official path: copy this file to .env.docker, replace every CHANGE_ME value,
# run `chmod 600 .env.docker`, then execute:
#   python3 backend/scripts/validate_production_deployment.py --env-file .env.docker
#
# .env.docker is Git ignored. Never commit it or paste its values into logs.

# Public origin. DNS must resolve this hostname to the VPS before Caddy starts.
DOMAIN=CHANGE_ME_DOMAIN
CORS_ORIGINS=https://CHANGE_ME_DOMAIN

# Immutable GHCR release pair. Tags (including latest) are not accepted.
BACKEND_IMAGE_REF=CHANGE_ME_BACKEND_DIGEST_REF
FRONTEND_IMAGE_REF=CHANGE_ME_FRONTEND_DIGEST_REF
RELEASE_GIT_SHA=CHANGE_ME_FULL_GIT_SHA

# PostgreSQL is private to the Compose network.
POSTGRES_DB=stockscanner
POSTGRES_USER=stockscanner
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_32_CHARS

# Browser authentication. Generate these independently; do not reuse values.
SERVER_AUTH_PASSWORD=CHANGE_ME_RANDOM_32_CHARS
SERVER_AUTH_SESSION_SECRET=CHANGE_ME_INDEPENDENT_RANDOM_64_CHARS
SERVER_AUTH_SECURE_COOKIE=true
SERVER_EXPOSE_API_DOCS=false

# Fixed first-release scope and schedule semantics.
ENABLED_MARKETS=US
COMPOSE_PROFILES=backup
CELERY_TIMEZONE=America/New_York
MARKET_DATA_SOURCE_MODE=github_first
STATIC_EXPORT_ENABLED=false

# Recommended 4-vCPU/8-GB starting values. Lower WEB_CONCURRENCY to 2 on the
# approved 2-vCPU/4-GB minimum host.
WEB_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Local PostgreSQL custom-format dumps. Off-host encrypted replication is still
# required for disaster recovery.
POSTGRES_BACKUP_RETENTION_COUNT=7
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
POSTGRES_BACKUP_INITIAL_DELAY_SECONDS=300

# Optional existing capabilities. Leave empty unless intentionally configured.
# GITHUB_DATA_TOKEN is an application token for release-data reads. A private
# GHCR pull token belongs in Docker's host credential store, not this file.
GITHUB_DATA_TOKEN=
ADMIN_API_KEY=

# Existing non-Market-Intelligence features remain disabled/unconfigured here.
FEATURE_GROUPED_SCAN_FILTERS=false
ZAI_API_KEY=
MINIMAX_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWITTER_BEARER_TOKEN=
